# Copia este archivo como .env y llena con los datos de TU proyecto de Firebase
# (los obtienes en: Firebase Console > Configuración del proyecto > Tus apps > SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
